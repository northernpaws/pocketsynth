	(gr_text "Case will be CNC machined aluminum\n1.5mm outer wall thickness"
		(at 14.3 18.8 0)
		(layer "Cmts.User")
		(uuid "05a6c17e-7a36-4172-8d39-3dccb5a2b681")
		(effects
			(font
				(size 1.5 1.5)
				(thickness 0.1)
			)
			(justify left bottom)
		)
	)
	(gr_text "Headphone lines routed down right PCB edge,\nconnect to headphone port on bottom edge."
		(at 109 72.1 90)
		(layer "Cmts.User")
		(uuid "4a45afd2-f0f1-45e8-89cc-42209ff49498")
		(effects
			(font
				(size 1 1)
				(thickness 0.15)
			)
			(justify left bottom)
		)
	)
	(gr_text "ISSI SRAM/SDRAM Layout Guide\nhttps://www.issi.com/WW/pdf/appnotes/dram/AN42S01.AN.pdf"
		(at 207.8 20 0)
		(layer "Cmts.User")
		(uuid "6a713f25-046d-42e7-8139-61a9357c39d0")
		(effects
			(font
				(size 1.5 1.5)
				(thickness 0.3)
				(bold yes)
			)
			(justify left bottom)
		)
	)
	(gr_text "10mm width for audio jack cables\n14mm width for USB-C cables\n"
		(at 80 21.1 0)
		(layer "Cmts.User")
		(uuid "8226e2c1-d5d7-44fd-8ca4-5528d55e5c6e")
		(effects
			(font
				(size 1 1)
				(thickness 0.1)
			)
			(justify left bottom)
		)
	)
	(gr_text "Top or bottom row: SHIFT/FUNC EDIT YES/COMMIT NO/CANCEL\n\nNAV(igation)\nPLAY\nREC\n\ncombine Yes/NO and PLAY/REC via shift/func key?\nwould disallow combos with play/rec though..\nplay/rec as defaults and func changes to yes/no?\n\nNAV enables arrow key navigation and menus\n\nCALC/EXP mode that makes the keypad a calculator input (numbers and expressions)"
		(at 124.6 120.9 0)
		(layer "Cmts.User")
		(uuid "97a15a7d-fb27-4f0f-aded-0c9da8e52e1c")
		(effects
			(font
				(size 2 2)
				(thickness 0.4)
				(bold yes)
			)
			(justify left bottom)
		)
	)
	(gr_text "Trace Length Matching Tolerance:\nSDRAM: 20mm (166Mhz)\nLCD: 50mm (100Mhz)"
		(at 207.6 30.1 0)
		(layer "Cmts.User")
		(uuid "ce7fd246-978f-4945-bd04-70c40db7e8f2")
		(effects
			(font
				(size 1.5 1.5)
				(thickness 0.3)
				(bold yes)
			)
			(justify left bottom)
		)
	)
	(gr_text "Case will have lanyard loop positioned\nin bottom center, under PCB."
		(at 67 170.6 0)
		(layer "Cmts.User")
		(uuid "e1628b36-19da-4bd3-8266-c79ba3617195")
		(effects
			(font
				(size 0.75 0.75)
				(thickness 0.1)
			)
			(justify bottom)
		)
	)
